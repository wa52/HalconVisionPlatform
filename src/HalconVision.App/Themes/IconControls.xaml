<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:HalconVision.App">
 <local:ActionIconConverter x:Key="ActionIconConverter"/>
 <local:ActionHelpConverter x:Key="ActionHelpConverter"/>
 <DataTemplate x:Key="ActionIconTemplate">
  <ContentPresenter>
   <ContentPresenter.Content>
    <MultiBinding Converter="{StaticResource ActionIconConverter}">
     <Binding/>
     <Binding Path="(local:IconUi.KeepText)" RelativeSource="{RelativeSource Self}"/>
    </MultiBinding>
   </ContentPresenter.Content>
  </ContentPresenter>
 </DataTemplate>
 <Style x:Key="IconButtonStyle" TargetType="Button">
  <Setter Property="ContentTemplate" Value="{StaticResource ActionIconTemplate}"/>
  <Setter Property="MinWidth" Value="32"/><Setter Property="MinHeight" Value="30"/>
  <Setter Property="ToolTip" Value="{Binding Content, RelativeSource={RelativeSource Self}, Converter={StaticResource ActionHelpConverter}}"/>
  <Setter Property="AutomationProperties.Name" Value="{Binding Content, RelativeSource={RelativeSource Self}}"/>
 </Style>
 <Style TargetType="ToggleButton">
  <Setter Property="ContentTemplate" Value="{StaticResource ActionIconTemplate}"/>
  <Setter Property="MinWidth" Value="34"/><Setter Property="MinHeight" Value="30"/>
  <Setter Property="ToolTip" Value="{Binding Content, RelativeSource={RelativeSource Self}, Converter={StaticResource ActionHelpConverter}}"/>
  <Setter Property="AutomationProperties.Name" Value="{Binding Content, RelativeSource={RelativeSource Self}}"/>
  <Setter Property="Cursor" Value="Hand"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
   <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="#4B626E" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
   </Border>
   <ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#65D6D0"/></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#65D6D0"/></Trigger>
    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Surface" Property="Background" Value="#087E83"/><Setter TargetName="Surface" Property="BorderBrush" Value="#65D6D0"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="IconMenuItemStyle" TargetType="MenuItem">
  <Setter Property="HeaderTemplate" Value="{StaticResource ActionIconTemplate}"/>
  <Setter Property="ToolTip" Value="{Binding Header, RelativeSource={RelativeSource Self}, Converter={StaticResource ActionHelpConverter}}"/>
  <Setter Property="AutomationProperties.Name" Value="{Binding Header, RelativeSource={RelativeSource Self}}"/>
 </Style>
 <Style x:Key="IconTabItemStyle" TargetType="TabItem">
  <Setter Property="HeaderTemplate" Value="{StaticResource ActionIconTemplate}"/>
  <Setter Property="ToolTip" Value="{Binding Header, RelativeSource={RelativeSource Self}, Converter={StaticResource ActionHelpConverter}}"/>
 </Style>
 <Style TargetType="Expander">
  <Setter Property="HeaderTemplate" Value="{StaticResource ActionIconTemplate}"/>
  <Setter Property="ToolTip" Value="{Binding Header, RelativeSource={RelativeSource Self}, Converter={StaticResource ActionHelpConverter}}"/>
 </Style>
 <Style TargetType="CheckBox">
  <Setter Property="ContentTemplate" Value="{StaticResource ActionIconTemplate}"/>
  <Setter Property="ToolTip" Value="{Binding Content, RelativeSource={RelativeSource Self}, Converter={StaticResource ActionHelpConverter}}"/>
 </Style>
</ResourceDictionary>
