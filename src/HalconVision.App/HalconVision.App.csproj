<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>HalconVision.App</AssemblyName>
    <RootNamespace>HalconVision.App</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\HalconVision.Application\HalconVision.Application.csproj" />
    <ProjectReference Include="..\HalconVision.Domain\HalconVision.Domain.csproj" />
    <ProjectReference Include="..\HalconVision.Halcon\HalconVision.Halcon.csproj" />
    <ProjectReference Include="..\HalconVision.Persistence\HalconVision.Persistence.csproj" />
    <PackageReference Include="MVTec.HalconDotNet-Windows" Version="24111.0.0" />
  </ItemGroup>
</Project>
