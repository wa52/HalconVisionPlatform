<Window x:Class="HalconVision.App.RunArchiveWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:HalconVision.App"
 Title="运行归档" Width="1100" Height="760" MinWidth="800" MinHeight="600" WindowStartupLocation="CenterOwner" Background="{StaticResource WorkbenchCanvasBrush}" Foreground="{StaticResource WorkbenchTextBrush}" FontFamily="{StaticResource WorkbenchFont}">
 <Window.Resources>
  <Style TargetType="TextBox" BasedOn="{StaticResource WorkbenchTextBoxStyle}"/>
  <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}"><Setter Property="Margin" Value="6,0,0,0"/><Setter Property="Padding" Value="10,6"/><Setter Property="Background" Value="{StaticResource WorkbenchRaisedBrush}"/><Setter Property="Foreground" Value="{StaticResource WorkbenchTextBrush}"/><Setter Property="FocusVisualStyle" Value="{StaticResource WorkbenchFocusVisual}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{StaticResource WorkbenchBorderBrush}" BorderThickness="1" CornerRadius="3" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource WorkbenchFocusBrush}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TabItem"><Setter Property="Foreground" Value="{StaticResource WorkbenchTextBrush}"/><Setter Property="Background" Value="{StaticResource WorkbenchRaisedBrush}"/><Setter Property="Padding" Value="12,7"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="Tab" Background="{TemplateBinding Background}" BorderBrush="{StaticResource WorkbenchBorderBrush}" BorderThickness="0,0,0,2" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Tab" Property="BorderBrush" Value="{StaticResource WorkbenchAccentBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TabControl"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl"><DockPanel><TabPanel DockPanel.Dock="Top" IsItemsHost="True"/><Border BorderBrush="{StaticResource WorkbenchBorderBrush}" BorderThickness="1"><ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/></Border></DockPanel></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="{StaticResource WorkbenchRaisedBrush}"/><Setter Property="Foreground" Value="{StaticResource WorkbenchTextBrush}"/><Setter Property="Padding" Value="8,5"/></Style>
  <Style TargetType="DataGridCell"><Setter Property="Foreground" Value="{StaticResource WorkbenchTextBrush}"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
 </Window.Resources>
 <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="2*" MinHeight="110"/><RowDefinition Height="5"/><RowDefinition Height="3*" MinHeight="130"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,12"><TextBlock Text="运行归档" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="按项目启用保存；历史结果只读，不替换当前流程或产品结论。" Foreground="{StaticResource WorkbenchMutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel>
  <Grid Grid.Row="1" Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="归档目录"/><TextBox x:Name="Folder" TextChanged="Folder_Changed" AutomationProperties.Name="归档目录" Margin="0,4,0,0"/></StackPanel><WrapPanel Grid.Column="1" VerticalAlignment="Bottom"><Button Content="选择归档目录" Click="Browse_Click"/><CheckBox x:Name="EnabledArchive" Content="自动归档" local:IconUi.KeepText="True" Foreground="{StaticResource WorkbenchTextBrush}" VerticalAlignment="Center" Margin="12,0,8,0"/><Button x:Name="SaveSettings" Content="保存归档设置" Click="Save_Click"/></WrapPanel></Grid>
  <Grid Grid.Row="2" Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><DockPanel><TextBlock Text="本页筛选" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBox x:Name="Search" AutomationProperties.Name="本页筛选" ToolTip="筛选本页的项目、流程、结论或运行ID" TextChanged="Search_Changed"/></DockPanel><WrapPanel Grid.Column="1"><TextBlock x:Name="PageLabel" VerticalAlignment="Center" Margin="10,0"/><Button x:Name="Previous" Content="上一页归档" Click="Previous_Click"/><Button x:Name="Next" Content="下一页归档" Click="Next_Click"/><Button x:Name="Refresh" Content="刷新归档" Click="Refresh_Click"/></WrapPanel></Grid>
  <Grid Grid.Row="3"><DataGrid x:Name="History" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="History_Changed" Background="{StaticResource WorkbenchSurfaceBrush}" RowBackground="{StaticResource WorkbenchSurfaceBrush}" AlternatingRowBackground="{StaticResource WorkbenchRaisedBrush}" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource WorkbenchBorderBrush}"><DataGrid.Columns>
   <DataGridTextColumn Header="完成时间" Binding="{Binding Completed}" Width="155"/><DataGridTextColumn Header="项目" Binding="{Binding Project}" Width="*" ElementStyle="{StaticResource WorkbenchCellText}"/><DataGridTextColumn Header="流程" Binding="{Binding Flow}" Width="*" ElementStyle="{StaticResource WorkbenchCellText}"/><DataGridTextColumn Header="历史结论" Binding="{Binding Verdict}" Width="105"/><DataGridTextColumn Header="运行ID" Binding="{Binding RunId}" Width="1.4*" ElementStyle="{StaticResource WorkbenchCellText}"/>
  </DataGrid.Columns></DataGrid><TextBlock x:Name="Empty" Text="选择归档目录后刷新；启用自动归档后，每轮完整检测都会保存。" TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource WorkbenchMutedBrush}" Margin="15" VerticalAlignment="Center" IsHitTestVisible="False"/></Grid>
  <GridSplitter Grid.Row="4" Height="5" HorizontalAlignment="Stretch" Background="{StaticResource WorkbenchBorderBrush}"/>
  <TabControl Grid.Row="5"><TabItem Header="历史结果" local:IconUi.KeepText="True"><TextBox x:Name="ResultDetail" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></TabItem><TabItem Header="流程快照" local:IconUi.KeepText="True"><TextBox x:Name="FlowDetail" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></TabItem></TabControl>
  <ScrollViewer Grid.Row="6" MaxHeight="70" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0"><TextBlock x:Name="Feedback" Text="查询按文件写入时间倒序，每页50条；筛选仅作用于本页。原图和模型未打包。" TextWrapping="Wrap"/></ScrollViewer>
 </Grid>
</Window>
