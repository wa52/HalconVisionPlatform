ding SelectedFlow.SelectedNode.OutputPorts}" Margin="0,5,0,10"><ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="0,3"><Ellipse Width="8" Height="8" Fill="#42B7E9" VerticalAlignment="Center" Margin="2,0,7,0"/><TextBlock Text="{Binding Name}" Foreground="#CED9DE"/><TextBlock Text="{Binding DataType}" Foreground="#82939D" DockPanel.Dock="Right"/></DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Expander><Separator Background="#34434E" Margin="0,4,0,10"/><Expander Header="相机连接控制" IsEnabled="{Binding CanConfigureCamera}" IsExpanded="True" Margin="0,0,0,10"><Expander.Style><Style TargetType="Expander" BasedOn="{StaticResource {x:Type Expander}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedFlow.SelectedNode.TypeId}" Value="halcon.camera-capture"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Expander.Style><StackPanel Margin="0,6,0,0"><TextBlock Text="HALCON 相机类别 / 采集接口" Foreground="#AAB8BE" FontSize="11" Margin="0,0,0,4"/><ComboBox ItemsSource="{Binding CameraInterfaces}" SelectedItem="{Binding SelectedCameraInterface}" DisplayMemberPath="DisplayName" SelectionChanged="CameraInterface_SelectionChanged"/><TextBlock Text="相机设备" Foreground="#AAB8BE" FontSize="11" Margin="0,8,0,4"/><ComboBox ItemsSource="{Binding CameraDevices}" SelectedItem="{Binding SelectedCameraDevice}" DisplayMemberPath="Name"/><DockPanel Margin="0,7,0,0"><Button Content="扫描" Click="ScanCameras_Click"/><Button Content="连接" Margin="6,0,0,0" Click="ConnectCamera_Click"/><Button Content="断开" Margin="6,0,0,0" Click="DisconnectCamera_Click"/><TextBlock Text="{Binding CameraStatus}" Foreground="#AAB8BE" VerticalAlignment="Center" Margin="8,0,0,0" TextWrapping="Wrap"/></DockPanel></StackPanel></Expander><TextBlock Text="参数设置" Foreground="#58B7B2" FontWeight="SemiBold" Margin="0,0,0,7"/><ItemsControl x:Name="NodeParametersEditor" ItemsSource="{Binding SelectedFlow.Sele