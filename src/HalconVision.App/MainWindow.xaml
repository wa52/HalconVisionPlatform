<Window x:Class="HalconVision.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ha="http://schemas.mvtec.com/halcondotnet" Title="HALCON Vision Workbench" Height="900" Width="1500" MinHeight="760" MinWidth="1180" WindowStartupLocation="CenterScreen" Background="#E9EDF1">
 <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="10"/><RowDefinition Height="48"/><RowDefinition Height="10"/><RowDefinition Height="*"/><RowDefinition Height="10"/><RowDefinition Height="145"/></Grid.RowDefinitions>
  <Border Grid.Row="0" Background="#17232D" CornerRadius="6" Padding="16,0"><DockPanel><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="34" Height="34" Background="#087E83" CornerRadius="5"><TextBlock Text="H" Foreground="White" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock Text="HALCON VISION WORKBENCH" Foreground="White" FontWeight="SemiBold" FontSize="15"/><TextBlock Text="独立视觉检测平台 · 离线调试" Foreground="#AAB7BF" FontSize="11" Margin="0,3,0,0"/></StackPanel></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="8" Height="8" Fill="#39B980" Margin="0,0,8,0"/><TextBlock x:Name="EnvironmentText" Foreground="#C5D0D5" VerticalAlignment="Center" Text="HALCON 正在检查…"/></StackPanel></DockPanel></Border>
  <Border Grid.Row="2" Background="White" CornerRadius="5" Padding="8,5"><DockPanel><TextBlock DockPanel.Dock="Left" Text="输入 / 回放" Foreground="#71808B" VerticalAlignment="Center" Margin="5,0,16,0"/><Button x:Name="OpenImageButton" Content="打开图像" Click="OpenImage_Click" Margin="0,0,6,0"/><Button Content="选择图像序列" Click="OpenSequence_Click" Margin="0,0,6,0"/><Button x:Name="DrawRoiButton" Content="绘制 ROI" Click="DrawRoi_Click" Margin="0,0,6,0"/><Separator Margin="6,4"/><Button x:Name="RunButton" Content="运行 Blob 检测" Click="Run_Click" IsEnabled="False" Background="#087E83" Foreground="White" BorderBrush="#087E83" Margin="0,0,6,0"/><Button x:Name="BatchButton" Content="目录批量检测" Click="Batch_Click" Margin="0,0,6,0"/><Button x:Name="PlayButton" Content="开始回放" Click="Play_Click" IsEnabled="False" Margin="0,0,6,0"/><Button x:Name="StopButton" Content="停止" Click="Stop_Click" IsEnabled="False" Margin="0,0,12,0"/><Button Content="加载方案" Click="LoadRecipe_Click" Margin="0,0,6,0"/><Button Content="保存方案" Click="SaveRecipe_Click"/><TextBlock x:Name="InputStateText" DockPanel.Dock="Right" Text="未加载图像" Foreground="#71808B" VerticalAlignment="Center" Margin="18,0,8,0"/></DockPanel></Border>
  <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="205"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions>
   <Border Grid.Column="0" Background="White" CornerRadius="5" Padding="14"><StackPanel><TextBlock Text="工作流" FontSize="13" FontWeight="SemiBold" Foreground="#17232D"/><TextBlock Text="INPUT" Foreground="#9AA6AD" FontSize="10" Margin="0,18,0,7"/><Border Background="#F2F6F6" CornerRadius="4" Padding="9"><StackPanel><TextBlock Text="▣  文件图像" Foreground="#087E83" FontWeight="SemiBold"/><TextBlock x:Name="ImageInfoText" Text="尚未载入样本" TextWrapping="Wrap" Foreground="#71808B" FontSize="11" Margin="0,7,0,0"/></StackPanel></Border><TextBlock Text="METHOD" Foreground="#9AA6AD" FontSize="10" Margin="0,20,0,7"/><Border Background="#F8F9FA" CornerRadius="4" Padding="9"><StackPanel><TextBlock Text="01  灰度阈值" Foreground="#33424B"/><TextBlock Text="02  连通域" Foreground="#33424B" Margin="0,8,0,0"/><TextBlock Text="03  面积筛选" Foreground="#087E83" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel></Border><TextBlock Text="RUNTIME" Foreground="#9AA6AD" FontSize="10" Margin="0,20,0,7"/><Border Background="#17232D" CornerRadius="4" Padding="10"><StackPanel><TextBlock Text="HALCON 24.11" Foreground="White" FontWeight="SemiBold"/><TextBlock Text=".NET x64 · local runtime" Foreground="#9BAAB2" FontSize="10" Margin="0,5,0,0"/><TextBlock Text="算子调用已验证" Foreground="#48C98A" FontSize="10" Margin="0,8,0,0"/></StackPanel></Border></StackPanel></Border>
   <Border Grid.Column="2" Background="#11191F" CornerRadius="5" Padding="5"><Grid><Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="*"/><RowDefinition Height="26"/></Grid.RowDefinitions><DockPanel Grid.Row="0" Margin="7,0"><TextBlock Text="图像视窗" Foreground="#DAE2E6" VerticalAlignment="Center" FontSize="11"/><TextBlock x:Name="ViewportModeText" Text="文件图像" Foreground="#78C9C3" DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="10"/></DockPanel><ha:HSmartWindowControlWPF x:Name="ImageWindow" Grid.Row="1" HMouseDown="ImageWindow_HMouseDown" HMouseUp="ImageWindow_HMouseUp" HMouseMove="ImageWindow_HMouseMove"/><DockPanel Grid.Row="2" Margin="7,0"><TextBlock Text="ROI 拖拽绘制 · 图像坐标" Foreground="#82939B" FontSize="10" VerticalAlignment="Center"/><TextBlock x:Name="CoordinateText" Text="X —  Y —" Foreground="#B7D5D2" FontFamily="Consolas" DockPanel.Dock="Right" VerticalAlignment="Center"/></DockPanel></Grid></Border>
   <Border Grid.Column="4" Background="White" CornerRadius="5" Padding="14"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><DockPanel><TextBlock Text="检测参数" FontSize="14" FontWeight="SemiBold" Foreground="#17232D"/><TextBlock x:Name="RecipeTitleText" Text="Blob / 默认方案" Foreground="#71808B" DockPanel.Dock="Right" FontSize="10" VerticalAlignment="Center"/></DockPanel><TextBlock Text="方案名称" Foreground="#71808B" FontSize="10" Margin="0,15,0,4"/><TextBox x:Name="RecipeNameBox" Text="扬声器 Blob 验证"/><TextBlock Text="灰度范围  ·  0—255" Foreground="#71808B" FontSize="10" Margin="0,12,0,4"/><UniformGrid Columns="2"><TextBox x:Name="ThresholdMinBox" Text="128" Margin="0,0,4,0"/><TextBox x:Name="ThresholdMaxBox" Text="255" Margin="4,0,0,0"/></UniformGrid><TextBlock Text="面积范围  ·  px²" Foreground="#71808B" FontSize="10" Margin="0,12,0,4"/><UniformGrid Columns="2"><TextBox x:Name="MinAreaBox" Text="20" Margin="0,0,4,0"/><TextBox x:Name="MaxAreaBox" Text="1000000" Margin="4,0,0,0"/></UniformGrid><TextBlock Text="目标连通域数" Foreground="#71808B" FontSize="10" Margin="0,12,0,4"/><TextBox x:Name="ExpectedCountBox" Text="1"/><TextBlock Text="矩形 ROI  ·  X / Y / 宽 / 高" Foreground="#71808B" FontSize="10" Margin="0,12,0,4"/><UniformGrid Columns="4"><TextBox x:Name="RoiXBox" Text="0" Margin="0,0,3,0"/><TextBox x:Name="RoiYBox" Text="0" Margin="3,0"/><TextBox x:Name="RoiWidthBox" Text="0" Margin="3,0"/><TextBox x:Name="RoiHeightBox" Text="0" Margin="3,0,0,0"/></UniformGrid><Separator Margin="0,15"/><TextBlock Text="检测结果" Foreground="#71808B" FontSize="10"/><DockPanel Margin="0,5,0,0"><TextBlock x:Name="CountText" Text="—" FontFamily="Consolas" FontSize="30" FontWeight="SemiBold" Foreground="#17232D"/><Border x:Name="DecisionBadge" Background="#EEF1F3" CornerRadius="4" Padding="10,5" DockPanel.Dock="Right" VerticalAlignment="Center"><TextBlock x:Name="DecisionText" Text="待检测" Foreground="#71808B" FontWeight="Bold"/></Border></DockPanel><TextBlock x:Name="ElapsedText" Text="等待运行" Foreground="#71808B" FontFamily="Consolas" FontSize="10" Margin="0,4,0,0"/></StackPanel></ScrollViewer></Border>
  </Grid>
  <Border Grid.Row="6" Background="White" CornerRadius="5" Padding="13"><DockPanel><TextBlock DockPanel.Dock="Top" Text="事件记录" Foreground="#17232D" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,7"/><ListBox x:Name="LogList" BorderThickness="0" Foreground="#4A5962" FontSize="11"/></DockPanel></Border>
 </Grid>
</Window>
