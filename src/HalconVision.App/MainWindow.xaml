   <StackPanel><Border Background="#2C3B46" CornerRadius="4,4,0,0" Padding="8,5" Height="28"><TextBlock Text="{Binding DisplayName}" Foreground="White" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></Border>
    <Grid Margin="3,1,3,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ItemsControl Grid.Column="0" HorizontalAlignment="Left" ItemsSource="{Binding InputPorts}" ItemTemplate="{StaticResource PortTemplate}"/><ItemsControl Grid.Column="1" HorizontalAlignment="Right" ItemsSource="{Binding OutputPorts}" ItemTemplate="{StaticResource PortTemplate}"/></Grid>
   </StackPanel>
  </Border></DataTemplate>
 <DataTemplate x:Key="NodeParameterEditor"><StackPanel Margin="0,0,0,10"><StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding IsCamera}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><TextBlock Text="{Binding Name}" Foreground="#AAB8BE" FontSize="11"/><Grid Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox Grid.Column="0" ItemsSource="{Binding TransitionChoices}" SelectedItem="{Binding SelectedTransition, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"><ComboBox.Style><Style TargetType="ComboBox"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsTransition}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></ComboBox.Style></ComboBox><CheckBox Grid.Column="0" AutomationProperties.Name="{Binding Name}" IsChecked="{Binding BooleanValue, UpdateSourceTrigger=PropertyChanged}" Foreground="#CED9DE" VerticalAlignment="Center"><CheckBox.Style><Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsBoolean}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></CheckBox.Style></CheckBox><TextBox Grid.Column="0" Text="{Binding ValueText, UpdateSourceTrigger=LostFocus}" LostFocus="Parameter_LostFocus" Tag="{Binding}"><TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Style.Triggers><DataTrigger Binding="{Binding IsPositionReference}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding IsRoiDraw}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding IsRoiList}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding IsLineDraw}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding IsBoolean}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding IsTransition}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBox.Style></TextBox><Button Grid.Column="1" Content="绘制矩形范围" Tag="{Binding}" Click="DrawRoi_Click" ToolTip="{Binding RoiDrawHelp}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsRoiDraw}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding IsQuickMatchTemplateRoi}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><Button Grid.Column="0" Grid.ColumnSpan="2" Content="绘制模板" HorizontalAlignment="Left" Tag="{Binding}" Click="DrawRoi_Click" AutomationProperties.Name="绘制模板" ToolTip="接收上游图像并在放大的模板绘制区拖动框选；松开完成，Esc 取消"><Button.ContentTemplate><DataTemplate><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7A8;" FontFamily="Segoe MDL2 Assets" FontSize="17" VerticalAlignment="Center"/><TextBlock Text="绘制模板" Margin="6,0,0,0" VerticalAlignment="Center"/></StackPanel></DataTemplate></Button.ContentTemplate><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsQuickMatchTemplateRoi}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><Button Grid.Column="2" Content="清除范围" Tag="{Binding}" Click="ClearRoi_Click" IsEnabled="{Binding CanClearRoi}" ToolTip="{Binding ClearRoiHelp}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsRoiDraw}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><Button Grid.Column="1" Content="选文件…" Tag="{Binding}" Click="PickImage_Click"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsPath}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><Button Grid.Column="2" Content="选文件夹…" Tag="{Binding}" Click="PickImage_Click"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsPath}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding IsImageFile}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><Button Grid.Column="3" Content="取当前图像为模板" Tag="{Binding}" Click="CaptureTemplate_Click"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsQuickMatchTemplateRoi}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style></Button></Grid><StackPanel Margin="0,4,0,0"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsPositionReference}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><TextBlock Text="{Binding ReferenceSummary}" TextWrapping="Wrap" Foreground="#CED9DE"/><WrapPanel Margin="0,6,0,0"><Button Content="设为基准" Tag="{Binding}" Click="TeachPosition_Click" Background="#087E83" Foreground="White"><Button.ContentTemplate><DataTemplate><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE81D;" FontFamily="Segoe MDL2 Assets" FontSize="17" VerticalAlignment="Center"/><TextBlock Text="设为基准" Margin="7,0,0,0" VerticalAlignment="Center"/></StackPanel></DataTemplate></Button.ContentTemplate></Button><Button Content="清除基准" Tag="{Binding}" Click="ClearPosition_Click" Margin="6,0,0,0"/></WrapPanel></StackPanel><local:RoiListEditor Parameter="{Binding}" DrawRequested="RoiList_DrawRequested"><local:RoiListEditor.Style><Style TargetType="local:RoiListEditor"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsRoiList}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></local:RoiListEditor.Style></local:RoiListEditor><TextBlock Text="{Binding Error}" Foreground="#F07878" FontSize="10" TextWrapping="Wrap"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding Error}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding Error}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel></DataTemplate>
</Window.Resources>
 <Grid><Grid.RowDefinitions><RowDefinition x:Name="MenuRow" Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border x:Name="WorkspaceHeader" Grid.Row="1" Background="{StaticResource WorkbenchSurfaceBrush}" BorderBrush="{StaticResource WorkbenchBorderBrush}" BorderThickness="0,0,0,1" Padding="8,6">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
  <Menu x:Name="EditorMenu" Grid.Column="0" VerticalAlignment="Center" Background="Transparent" Foreground="#C7D2D8" Padding="0" BorderThickness="0">
   <MenuItem Header="文件"><MenuItem Header="新建项目…" Click="NewProject_Click"/><MenuItem Header="打开项目…" Click="OpenProject_Click"/><Separator/><MenuItem Header="保存项目" Click="Save_Click"/><Separator/><MenuItem Header="退出" Click="Exit_Click"/></MenuItem>
   <MenuItem Header="视图"><MenuItem Header="检测显示配置…" IsEnabled="{Binding HasProject}" Click="ConfigureDetectionDisplay_Click"/><Separator/><MenuItem Header="节点库面板" Click="ToggleLeft_Click"/><MenuItem Header="属性面板" Click="ToggleRight_Click"/><MenuItem Header="下方调试面板" Click="ToggleBottom_Click"/></MenuItem>
   <MenuItem Header="项目"><MenuItem Header="新建流程…" Click="NewFlow_Click"/><MenuItem Header="导入流程…" Click="ImportFlow_Click"/><MenuItem Header="导出当前流程…" Click="ExportFlow_Click"/><MenuItem Header="检测任务…" Click="ConfigureInspectionTasks_Click"/></MenuItem>
   <MenuItem Header="帮助"><MenuItem Header="关于 HALCON 节点平台" Click="About_Click"/></MenuItem>
  </Menu>
    <Grid Grid.Column="1" Margin="14,0" VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="{Binding ProjectName}" ToolTip="{Binding ProjectName}" Foreground="{StaticResource WorkbenchTextBrush}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
      <Border Grid.Column="1" BorderBrush="{StaticResource WorkbenchBorderBrush}" BorderThickness="1,0,0,0" Padding="12,0,0,0" Margin="16,0,0,0" MaxWidth="240"><TextBlock x:Name="ProductVerdict" Text="{Binding ProductVerdictText}" ToolTip="{Binding ProductVerdictText}" Foreground="{Binding ProductVerdictBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/></Border>
    </Grid>
    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="单次运行" Click="Run_Click" Background="#087E83" BorderBrush="#149B99" Foreground="White"/><Button Content="连续运行" Click="ContinuousRun_Click" Background="#28634D" BorderBrush="#388565" Foreground="White"/><Button Content="停止" Click="CancelRun_Click"/><ToggleButton x:Name="DetectionModeToggle" Content="检测模式" Checked="DetectionMode_Changed" Unchecked="DetectionMode_Changed" Padding="10,5" Margin="4,0" Foreground="#E0E8EC" Background="#28634D"/></StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Row="2" x:Name="WorkspaceGrid" Background="#111820"><Grid.ColumnDefinitions><ColumnDefinition x:Name="LeftColumn" Width="260" MinWidth="140"/><ColumnDefinition x:Name="LeftSplitterColumn" Width="5"/><ColumnDefinition Width="*" MinWidth="420"/><ColumnDefinition x:Name="RightSplitterColumn" Width="5"/><ColumnDefinition x:Name="RightColumn" Width="300" MinWidth="260"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="*" MinHeight="220"/><RowDefinition x:Name="BottomSplitterRow" Height="5"/><RowDefinition x:Name="BottomRow" Height="270" MinHeight="150"/></Grid.RowDefinitions>
    <Border x:Name="LeftPanel" Grid.Column="0" Grid.RowSpan="3" Background="{StaticResource WorkbenchSurfaceBrush}" BorderBrush="{StaticResource WorkbenchBorderBrush}" BorderThickness="0,0,1,0">
      <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource WorkbenchRaisedBrush}" Padding="12,12">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="节点库" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="1" Text="{Binding FilteredNodeCatalog.Count, StringFormat={}{0} 个节点}" Foreground="{StaticResource WorkbenchMutedBrush}" FontSize="11" VerticalAlignment="Center"/>
          </Grid>
        </Border>
        <StackPanel DockPanel.Dock="Top" Margin="10,10,10,6">
          <TextBox Text="{Binding NodeSearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="搜索节点名称或类别" AutomationProperties.Name="搜索节点名称或类别"/>
          <TextBlock Foreground="{StaticResource WorkbenchMutedBrush}" FontSize="11" Margin="2,7,0,0" TextWrapping="Wrap">
            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="双击节点添加到当前流程"/><Style.Triggers><DataTrigger Binding="{Binding HasProject}" Value="False"><Setter Property="Text" Value="双击节点：先保存项目，再加入主流程"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
          </TextBlock>
        </StackPanel>
        <Grid>
          <ListBox x:Name="NodeCatalogList" ItemsSource="{Binding Source={StaticResource CatalogGroups}}" MouseDoubleClick="NodeCatalog_DoubleClick" ItemContainerStyle="{StaticResource WorkbenchCatalogItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.IsVirtualizingWhenGrouping="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True">
            <ListBox.GroupStyle><GroupStyle><GroupStyle.HeaderTemplate><DataTemplate><TextBlock Text="{Binding Name}" Foreground="{StaticResource WorkbenchAccentBrush}" FontSize="11" FontWeight="SemiBold" Margin="14,14,8,5"/></DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></ListBox.GroupStyle>
            <ListBox.ItemTemplate><DataTemplate><Grid ToolTip="{Binding Description}" ToolTipService.InitialShowDelay="1500"><Grid.ColumnDefinitions><ColumnDefinition Width="25"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource WorkbenchMutedBrush}" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/></Grid></DataTemplate></ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Text="没有匹配的节点，试试其他名称或类别" Foreground="{StaticResource WorkbenchMutedBrush}" TextWrapping="Wrap" Margin="14,20" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding FilteredNodeCatalog.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
        </Grid>
      </DockPanel>
    </Border>
   <GridSplitter x:Name="LeftDockSplitter" Grid.Column="1" Grid.RowSpan="3" Width="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#34434E" ShowsPreview="False"/>
   <Grid Grid.Column="2" Grid.Row="0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Grid.Row="0" Background="#1B2731" BorderBrush="#34434E" BorderThickness="0,0,0,1"><DockPanel><TextBlock Text="流程编辑器" Foreground="#E1E8EC" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,7"/></DockPanel></Border>
    <Border Grid.Row="1" Background="#202C36" BorderBrush="#34434E" BorderThickness="0,0,0,1"><WrapPanel VerticalAlignment="Center" Margin="5,0"><Button Content="添加所选节点" Click="AddNode_Click"/><Button Content="复制节点" Click="Copy_Click"/><Button Content="粘贴节点" Click="Paste_Click"/><Button Content="删除节点" ToolTip="删除所选节点（Delete）" Click="Delete_Click"/><Button Content="撤销" Click="Undo_Click"/><Button Content="重做" Click="Redo_Click"/><Separator Width="1" Margin="8,5"/><Button Content="−" ToolTip="缩小画布" Click="CanvasZoomOut_Click" Width="30" Padding="4,3"/><Button Content="+" ToolTip="放大画布" Click="CanvasZoomIn_Click" Width="30" Padding="4,3"/><Button x:Name="FitCanvasButton" Content="适应画布" Click="FitCanvas_Click"/><TextBlock Text="选中节点后按 Delete 删除 · 中键拖动画布 · Ctrl+滚轮缩放 · Ctrl+S 保存" Foreground="#8D9DA6" VerticalAlignment="Center" TextWrapping="Wrap" Margin="8,4"/></WrapPanel></Border>
    <TabControl Grid.Row="2" ItemsSource="{Binding Flows}" SelectedItem="{Binding SelectedFlow}" Background="#151E26" BorderThickness="0"><TabControl.ItemTemplate><DataTemplate><DockPanel><TextBlock Text="◈" Foreground="#58B7B2" Margin="0,0,6,0"/><TextBlock Text="{Binding TabLabel}" Padding="2,0"/></DockPanel></DataTemplate></TabControl.ItemTemplate><TabControl.ContentTemplate><DataTemplate><Grid Background="#151E26" ClipToBounds="True" PreviewMouseWheel="Canvas_MouseWheel"><ScrollViewer x:Name="FlowCanvasScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" PreviewMouseWheel="Canvas_MouseWheel" PreviewMouseDown="Canvas_MouseDown" PreviewMouseMove="Canvas_MouseMove" PreviewMouseUp="Canvas_MouseUp" Background="#151E26"><Canvas x:Name="NodeCanvas" Width="2200" Height="1400" Background="{StaticResource CanvasGrid}"><Canvas.LayoutTransform><ScaleTransform ScaleX="{Binding Zoom}" ScaleY="{Binding Zoom}"/></Canvas.LayoutTransform>
      <ItemsControl ItemsSource="{Binding Edges}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Line X1="{Binding X1}" Y1="{Binding Y1}" X2="{Binding X2}" Y2="{Binding Y2}" Stroke="{Binding State}" StrokeThickness="2.5" IsHitTestVisible="False"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <ItemsControl ItemsSource="{Binding Nodes}" ItemTemplate="{StaticResource NodeTemplate}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Canvas.Left" Value="{Binding X}"/><Setter Property="Canvas.Top" Value="{Binding Y}"/></Style></ItemsControl.ItemContainerStyle></ItemsControl>
     </Canvas></ScrollViewer></Grid></DataTemplate></TabControl.ContentTemplate></TabControl>
  </Grid>
