  </CollectionViewSource>
  <SolidColorBrush x:Key="Chrome" Color="#17212A"/><SolidColorBrush x:Key="Panel" Color="#1B2731"/>
  <SolidColorBrush x:Key="PanelRaised" Color="#202E39"/><SolidColorBrush x:Key="Line" Color="#34434E"/>
