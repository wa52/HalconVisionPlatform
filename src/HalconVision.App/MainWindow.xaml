<Window x:Class="HalconVision.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ha="http://schemas.mvtec.com/halcondotnet"
        Title="HalconVisionPlatform · 工业视觉检测平台" Height="940" Width="1580" MinHeight="720" MinWidth="1180"
        Background="#111820" Foreground="#D6E0E5" WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded" Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown" PreviewMouseMove="Window_PreviewMouseMove" PreviewMouseLeftButtonUp="Window_PreviewMouseLeftButtonUp">
 <Window.Resources>
  <SolidColorBrush x:Key="Chrome" Color="#17212A"/><SolidColorBrush x:Key="Panel" Color="#1B2731"/>
  <SolidColorBrush x:Key="PanelRaised" Color="#202E39"/><SolidColorBrush x:Key="Line" Color="#34434E"/>
  <SolidColorBrush x:Key="TextMain" Color="#DCE5E9"/><SolidColorBrush x:Key="TextMuted" Color="#8D9DA6"/>
  <SolidColorBrush x:Key="Accent" Color="#20A6A2"/>
  <DrawingBrush x:Key="CanvasGrid" TileMode="Tile" Viewport="0,0,24,24" ViewportUnits="Absolute">
   <DrawingBrush.Drawing><DrawingGroup><GeometryDrawing Brush="#171F27" Geometry="M0,0 H24 V24 H0Z"/><GeometryDrawing><GeometryDrawing.Pen><Pen Brush="#25313A" Thickness="1"/></GeometryDrawing.Pen><GeometryDrawing.Geometry><GeometryGroup><LineGeometry StartPoint="0,0" EndPoint="24,0"/><LineGeometry StartPoint="0,0" EndPoint="0,24"/></GeometryGroup></GeometryDrawing.Geometry></GeometryDrawing></DrawingGroup></DrawingBrush.Drawing>
  </DrawingBrush>
  <Style TargetType="Button"><Setter Property="Foreground" Value="#D5E0E5"/><Setter Property="Background" Value="#26343F"/><Setter Property="BorderBrush" Value="#3B4A55"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="9,5"/><Setter Property="Margin" Value="2"/><Setter Property="FontSize" Value="12"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#334650"/><Setter TargetName="Bd" Property="BorderBrush" Value="#4A747A"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Background" Value="#087E83"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TextBox"><Setter Property="Foreground" Value="#DCE5E9"/><Setter Property="Background" Value="#121B22"/><Setter Property="BorderBrush" Value="#3B4A55"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="7,5"/><Setter Property="FontSize" Value="12"/></Style>
  <Style TargetType="TabControl"><Setter Property="Background" Value="#1B2731"/><Setter Property="BorderBrush" Value="#34434E"/></Style>
  <Style TargetType="TabItem"><Setter Property="Foreground" Value="#B8C5CB"/><Setter Property="Background" Value="#202D37"/><Setter Property="Padding" Value="12,6"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="TabBorder" Background="{TemplateBinding Background}" BorderBrush="#34434E" BorderThickness="0,0,0,1" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="#17232C"/><Setter TargetName="TabBorder" Property="BorderBrush" Value="#20A6A2"/><Setter TargetName="TabBorder" Property="BorderThickness" Value="0,0,0,2"/><Setter Property="Foreground" Value="White"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TreeView"><Setter Property="Background" Value="#1B2731"/><Setter Property="Foreground" Value="#CCD7DC"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="4"/></Style>
  <Style TargetType="ListBox"><Setter Property="Background" Value="#1B2731"/><Setter Property="Foreground" Value="#CCD7DC"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="2"/></Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#26343F"/><Setter Property="Foreground" Value="#C9D5DA"/><Setter Property="BorderBrush" Value="#34434E"/><Setter Property="BorderThickness" Value="0,0,1,1"/><Setter Property="Padding" Value="8,6"/></Style>
  <Style TargetType="DataGridCell"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#CED9DE"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="7,4"/></Style>
  <Style TargetType="MenuItem"><Setter Property="Foreground" Value="#D3DEE3"/><Setter Property="Background" Value="#17212A"/><Setter Property="Padding" Value="9,5"/></Style>
  <DataTemplate x:Key="PortTemplate"><Button Width="22" Height="22" Padding="0" Margin="0,-2" Background="Transparent" BorderThickness="0" Tag="{Binding}" PreviewMouseLeftButtonDown="Port_PreviewMouseLeftButtonDown" Click="Port_Click" ToolTip="拖到目标输入端口以连线；也可单击端口">
   <Ellipse Width="12" Height="12" Fill="#42B7E9" Stroke="#DDF6FF" StrokeThickness="1.5" VerticalAlignment="Center"/>
  </Button></DataTemplate>
  <DataTemplate x:Key="NodeTemplate"><Border Width="164" Focusable="True" Background="#202D37" BorderBrush="#465660" BorderThickness="1" CornerRadius="5" Padding="0" MouseLeftButtonDown="Node_MouseDown" MouseMove="Node_MouseMove" MouseLeftButtonUp="Node_MouseUp">
   <Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="#465660"/><Style.Triggers><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="BorderBrush" Value="#43B8E9"/><Setter Property="BorderThickness" Value="2"/></DataTrigger></Style.Triggers></Style></Border.Style>
   <StackPanel><Border Background="#2C3B46" CornerRadius="4,4,0,0" Padding="8,5" Height="28"><TextBlock Text="{Binding DisplayName}" Foreground="White" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></Border>
    <Grid Margin="3,1,3,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ItemsControl Grid.Column="0" HorizontalAlignment="Left" ItemsSource="{Binding InputPorts}" ItemTemplate="{StaticResource PortTemplate}"/><ItemsControl Grid.Column="1" HorizontalAlignment="Right" ItemsSource="{Binding OutputPorts}" ItemTemplate="{StaticResource PortTemplate}"/></Grid>
   </StackPanel>
  </Border></DataTemplate>
 </Window.Resources>
 <Grid><Grid.RowDefinitions><RowDefinition Height="26"/><RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="24"/></Grid.RowDefinitions>
  <Menu Grid.Row="0" Background="#151E26" Foreground="#C7D2D8" Padding="4,0" BorderBrush="#2B3943" BorderThickness="0,0,0,1">
   <MenuItem Header="文件"><MenuItem Header="新建项目…" Click="NewProject_Click"/><MenuItem Header="打开项目…" Click="OpenProject_Click"/><Separator/><MenuItem Header="保存项目" Click="Save_Click"/><Separator/><MenuItem Header="退出" Click="Exit_Click"/></MenuItem>
   <MenuItem Header="编辑"><MenuItem Header="撤销" Click="Undo_Click"/><MenuItem Header="重做" Click="Redo_Click"/><Separator/><MenuItem Header="复制节点" Click="Copy_Click"/><MenuItem Header="粘贴节点" Click="Paste_Click"/><MenuItem Header="删除节点 (Delete)" Click="Delete_Click"/></MenuItem>
   <MenuItem Header="视图"><MenuItem Header="节点库面板" Click="ToggleLeft_Click"/><MenuItem Header="属性面板" Click="ToggleRight_Click"/><MenuItem Header="下方调试面板" Click="ToggleBottom_Click"/></MenuItem>
   <MenuItem Header="项目"><MenuItem Header="新建流程…" Click="NewFlow_Click"/><MenuItem Header="导入流程…" Click="ImportFlow_Click"/><MenuItem Header="导出当前流程…" Click="ExportFlow_Click"/></MenuItem>
   <MenuItem Header="运行"><MenuItem Header="运行流程" Click="Run_Click"/><MenuItem Header="停止运行" Click="CancelRun_Click"/></MenuItem>
   <MenuItem Header="帮助"><MenuItem Header="关于 HALCON 节点平台" Click="About_Click"/></MenuItem>
  </Menu>
  <Border Grid.Row="1" Background="#1A252E" BorderBrush="#2C3B45" BorderThickness="0,0,0,1" Padding="8,4"><DockPanel LastChildFill="True">
   <StackPanel DockPanel.Dock="Left" Orientation="Horizontal"><Border Width="32" Height="32" Background="#087E83" CornerRadius="5" Margin="2,0,8,0"><TextBlock Text="H" Foreground="White" FontSize="21" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel VerticalAlignment="Center"><TextBlock Text="HalconVisionPlatform" Foreground="White" FontWeight="SemiBold"/><TextBlock Text="工业视觉检测平台 · 节点工程工作台" Foreground="#91A1AA" FontSize="10"/></StackPanel></StackPanel>
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="{Binding ProjectName}" Foreground="#CFD9DE" VerticalAlignment="Center" Margin="8,0,12,0"/><Button Content="新建" Click="NewProject_Click"/><Button Content="打开" Click="OpenProject_Click"/><Button Content="保存" Click="Save_Click"/><Border Width="1" Background="#3B4A55" Margin="7,3"/><Button Content="撤销" Click="Undo_Click"/><Button Content="重做" Click="Redo_Click"/><Button Content="单次运行" Click="Run_Click" Background="#087E83" BorderBrush="#149B99" Foreground="White"/><Button Content="连续运行" Click="ContinuousRun_Click" Background="#28634D" BorderBrush="#388565" Foreground="White"/><Button Content="停止" Click="CancelRun_Click"/><Button Content="适应画布" Click="FitCanvas_Click"/></StackPanel>
  </DockPanel></Border>
  <Grid Grid.Row="2" x:Name="WorkspaceGrid" Background="#111820"><Grid.ColumnDefinitions><ColumnDefinition x:Name="LeftColumn" Width="260" MinWidth="0"/><ColumnDefinition x:Name="LeftSplitterColumn" Width="5"/><ColumnDefinition Width="*" MinWidth="420"/><ColumnDefinition x:Name="RightSplitterColumn" Width="5"/><ColumnDefinition x:Name="RightColumn" Width="300" MinWidth="0"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="*" MinHeight="220"/><RowDefinition x:Name="BottomSplitterRow" Height="5"/><RowDefinition x:Name="BottomRow" Height="270" MinHeight="0"/></Grid.RowDefinitions>
    <Border Grid.Column="0" Grid.RowSpan="3" Background="#1B2731" BorderBrush="#34434E" BorderThickness="0,0,1,0"><DockPanel><Border DockPanel.Dock="Top" Background="#202E39" Padding="11,10"><DockPanel><StackPanel><TextBlock Text="节点库" Foreground="#E0E8EC" FontWeight="SemiBold"/><TextBlock Text="按类别浏览已注册节点" Foreground="#82939D" FontSize="10" Margin="0,3,0,0"/></StackPanel><TextBlock Text="{Binding NodeCatalog.Count, StringFormat={}{0} 个节点}" Foreground="#82939D" FontSize="10" DockPanel.Dock="Right" VerticalAlignment="Center"/></DockPanel></Border><StackPanel DockPanel.Dock="Top" Margin="9,8"><TextBox Text="{Binding NodeSearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="搜索节点名称或类别"/><TextBlock Text="双击节点添加到当前流程" Foreground="#82939D" FontSize="10" Margin="3,6,0,0"/></StackPanel><ListBox x:Name="NodeCatalogList" ItemsSource="{Binding FilteredNodeCatalog}" MouseDoubleClick="NodeCatalog_DoubleClick"><ListBox.ItemTemplate><DataTemplate><Border Padding="8,6" Margin="2,2" Background="#202E39" BorderBrush="#30404B" BorderThickness="1" CornerRadius="4" ToolTip="{Binding Description}" ToolTipService.InitialShowDelay="350"><TextBlock Text="{Binding DisplayName}" Foreground="#DCE5E9" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis"/></Border></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel></Border>
   <GridSplitter Grid.Column="1" Grid.RowSpan="3" Width="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#34434E" ShowsPreview="False"/>
   <Grid Grid.Column="2" Grid.Row="0"><Grid.RowDefinitions><RowDefinition Height="37"/><RowDefinition Height="36"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Grid.Row="0" Background="#1B2731" BorderBrush="#34434E" BorderThickness="0,0,0,1"><DockPanel><TextBlock Text="流程编辑器" Foreground="#E1E8EC" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0"/><TextBlock Text="{Binding ProjectStatus}" Foreground="#8999A3" VerticalAlignment="Center" DockPanel.Dock="Right" Margin="6,0,10,0"/><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="新建流程 +" Click="NewFlow_Click"/><Button Content="导入" Click="ImportFlow_Click"/><Button Content="导出" Click="ExportFlow_Click"/></StackPanel></DockPanel></Border>
    <Border Grid.Row="1" Background="#202C36" BorderBrush="#34434E" BorderThickness="0,0,0,1"><StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="5,0"><Button Content="添加所选节点" Click="AddNode_Click"/><Button Content="删除节点" ToolTip="删除所选节点（Delete）" Click="Delete_Click"/><Button Content="撤销" Click="Undo_Click"/><Button Content="重做" Click="Redo_Click"/><Separator Width="1" Margin="8,5"/><Button Content="−" ToolTip="缩小画布" Click="CanvasZoomOut_Click" Width="30" Padding="4,3"/><Button Content="+" ToolTip="放大画布" Click="CanvasZoomIn_Click" Width="30" Padding="4,3"/><TextBlock Text="选中节点后按 Delete 删除 · 中键拖动画布 · Ctrl+滚轮缩放 · Ctrl+S 保存" Foreground="#8D9DA6" VerticalAlignment="Center" Margin="8,0"/></StackPanel></Border>
    <TabControl Grid.Row="2" ItemsSource="{Binding Flows}" SelectedItem="{Binding SelectedFlow}" Background="#151E26" BorderThickness="0"><TabControl.ItemTemplate><DataTemplate><DockPanel><TextBlock Text="◈" Foreground="#58B7B2" Margin="0,0,6,0"/><TextBlock Text="{Binding TabLabel}" Padding="2,0"/></DockPanel></DataTemplate></TabControl.ItemTemplate><TabControl.ContentTemplate><DataTemplate><Grid Background="#151E26" ClipToBounds="True" PreviewMouseWheel="Canvas_MouseWheel"><ScrollViewer x:Name="FlowCanvasScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" PreviewMouseWheel="Canvas_MouseWheel" PreviewMouseDown="Canvas_MouseDown" PreviewMouseMove="Canvas_MouseMove" PreviewMouseUp="Canvas_MouseUp" Background="#151E26"><Canvas x:Name="NodeCanvas" Width="2200" Height="1400" Background="{StaticResource CanvasGrid}"><Canvas.LayoutTransform><ScaleTransform ScaleX="{Binding Zoom}" ScaleY="{Binding Zoom}"/></Canvas.LayoutTransform>
      <ItemsControl ItemsSource="{Binding Edges}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Line X1="{Binding X1}" Y1="{Binding Y1}" X2="{Binding X2}" Y2="{Binding Y2}" Stroke="{Binding State}" StrokeThickness="2.5" IsHitTestVisible="False"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <ItemsControl ItemsSource="{Binding Nodes}" ItemTemplate="{StaticResource NodeTemplate}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Canvas.Left" Value="{Binding X}"/><Setter Property="Canvas.Top" Value="{Binding Y}"/></Style></ItemsControl.ItemContainerStyle></ItemsControl>
     </Canvas></ScrollViewer><Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12" Background="#E51B2731" BorderBrush="#465660" BorderThickness="1" CornerRadius="5" Padding="10,6"><TextBlock Text="节点流程画布" Foreground="#C6D2D8" FontSize="10"/></Border></Grid></DataTemplate></TabControl.ContentTemplate></TabControl>
   </Grid>
   <GridSplitter Grid.Column="3" Grid.Row="0" Grid.RowSpan="1" Width="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#34434E" ShowsPreview="False"/>
   <Border Grid.Column="4" Grid.Row="0" Background="#1B2731" BorderBrush="#34434E" BorderThickness="1,0,0,0"><DockPanel><Border DockPanel.Dock="Top" Background="#202E39" Padding="12,10"><DockPanel><TextBlock Text="节点属性" Foreground="#E0E8EC" FontWeight="SemiBold"/><TextBlock Text="流程 / 参数" Foreground="#82939D" FontSize="10" DockPanel.Dock="Right" VerticalAlignment="Center"/></DockPanel></Border><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12"><TextBlock Text="基础信息" Foreground="#58B7B2" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8"/><TextBlock Text="节点名称" Foreground="#91A1AA" FontSize="11"/><TextBox Text="{Binding SelectedFlow.SelectedNode.DisplayName, UpdateSourceTrigger=LostFocus}" Margin="0,4,0,10"/><TextBlock Text="节点类型" Foreground="#91A1AA" FontSize="11"/><TextBlock Text="{Binding SelectedFlow.SelectedNode.TypeId}" Foreground="#C3D0D6" TextWrapping="Wrap" Margin="0,4,0,12"/><Separator Background="#34434E" Margin="0,4,0,10"/><TextBlock Text="输入端口" Foreground="#58B7B2" FontWeight="SemiBold"/><ItemsControl ItemsSource="{Binding SelectedFlow.SelectedNode.InputPorts}" Margin="0,5,0,10"><ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="0,3"><Ellipse Width="8" Height="8" Fill="#42B7E9" VerticalAlignment="Center" Margin="2,0,7,0"/><TextBlock Text="{Binding Name}" Foreground="#CED9DE"/><TextBlock Text="{Binding DataType}" Foreground="#82939D" DockPanel.Dock="Right"/></DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="输出端口" Foreground="#58B7B2" FontWeight="SemiBold"/><ItemsControl ItemsSource="{Binding SelectedFlow.SelectedNode.OutputPorts}" Margin="0,5,0,10"><ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="0,3"><Ellipse Width="8" Height="8" Fill="#42B7E9" VerticalAlignment="Center" Margin="2,0,7,0"/><TextBlock Text="{Binding Name}" Foreground="#CED9DE"/><TextBlock Text="{Binding DataType}" Foreground="#82939D" DockPanel.Dock="Right"/></DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Separator Background="#34434E" Margin="0,4,0,10"/><Expander Header="相机连接控制" IsEnabled="{Binding CanConfigureCamera}" IsExpanded="True" Margin="0,0,0,10"><Expander.Style><Style TargetType="Expander"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedFlow.SelectedNode.TypeId}" Value="halcon.camera-capture"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Expander.Style><StackPanel Margin="0,6,0,0"><TextBlock Text="HALCON 相机类别 / 采集接口" Foreground="#AAB8BE" FontSize="11" Margin="0,0,0,4"/><ComboBox ItemsSource="{Binding CameraInterfaces}" SelectedItem="{Binding SelectedCameraInterface}" DisplayMemberPath="DisplayName" SelectionChanged="CameraInterface_SelectionChanged"/><TextBlock Text="相机设备" Foreground="#AAB8BE" FontSize="11" Margin="0,8,0,4"/><ComboBox ItemsSource="{Binding CameraDevices}" SelectedItem="{Binding SelectedCameraDevice}" DisplayMemberPath="Name"/><DockPanel Margin="0,7,0,0"><Button Content="扫描" Click="ScanCameras_Click"/><Button Content="连接" Margin="6,0,0,0" Click="ConnectCamera_Click"/><Button Content="断开" Margin="6,0,0,0" Click="DisconnectCamera_Click"/><TextBlock Text="{Binding CameraStatus}" Foreground="#AAB8BE" VerticalAlignment="Center" Margin="8,0,0,0" TextWrapping="Wrap"/></DockPanel></StackPanel></Expander><TextBlock Text="参数设置" Foreground="#58B7B2" FontWeight="SemiBold" Margin="0,0,0,7"/><ItemsControl ItemsSource="{Binding SelectedFlow.SelectedNode.Parameters}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,0,10"><StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding IsCamera}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><TextBlock Text="{Binding Name}" Foreground="#AAB8BE" FontSize="11"/><Grid Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Grid.Column="0" Text="{Binding ValueText, UpdateSourceTrigger=LostFocus}" LostFocus="Parameter_LostFocus" Tag="{Binding}"/><Button Grid.Column="1" Content="选文件…" Tag="{Binding}" Click="PickImage_Click"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsPath}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><Button Grid.Column="2" Content="选文件夹…" Tag="{Binding}" Click="PickImage_Click"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsPath}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style></Button></Grid><TextBlock Text="{Binding Error}" Foreground="#F07878" FontSize="10" TextWrapping="Wrap"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Separator Background="#34434E" Margin="0,4,0,10"/><TextBlock Text="流程校验" Foreground="#58B7B2" FontWeight="SemiBold"/><ItemsControl ItemsSource="{Binding SelectedFlow.ValidationIssues}" Margin="0,5,0,0"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Message}" Foreground="#E58C76" FontSize="10" TextWrapping="Wrap" Margin="0,3"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer></DockPanel></Border>
   <GridSplitter Grid.Column="2" Grid.Row="1" Grid.ColumnSpan="3" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#34434E" ShowsPreview="False"/>
   <Grid Grid.Column="2" Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="5"/><ColumnDefinition Width="1.15*"/></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="#1B2731" BorderBrush="#34434E" BorderThickness="0,1,0,0"><DockPanel><Border DockPanel.Dock="Top" Background="#202E39" Padding="8,5"><DockPanel LastChildFill="False"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="−" ToolTip="缩小" Click="ImageZoomOut_Click" Width="30" Padding="4,3"/><Button Content="+" ToolTip="放大" Click="ImageZoomIn_Click" Width="30" Padding="4,3"/><Button Content="适应" ToolTip="适应窗口" Click="ImageFit_Click" Padding="7,3"/><Button Content="独立放大" Click="OpenImageViewer_Click" Padding="8,3"/></StackPanel><TextBlock Text="节点图像" Foreground="#E0E8EC" FontWeight="SemiBold" VerticalAlignment="Center" DockPanel.Dock="Left"/><TextBlock Text="滚轮缩放 · 按住左键拖动" Foreground="#82939D" FontSize="10" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="10,0"/></DockPanel></Border><Grid x:Name="PreviewHost" Background="#0C1318" PreviewMouseWheel="PreviewHost_MouseWheel" PreviewMouseLeftButtonDown="PreviewHost_MouseDown" PreviewMouseMove="PreviewHost_MouseMove" PreviewMouseLeftButtonUp="PreviewHost_MouseUp"><ha:HSmartWindowControlWPF x:Name="PreviewWindow"/><TextBlock x:Name="PreviewEmptyText" Text="选择流程节点后显示该节点图像或处理结果" Foreground="#7E8F99" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/></Grid></DockPanel></Border>
    <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#34434E"/>
    <Border Grid.Column="2" Background="#1B2731" BorderBrush="#34434E" BorderThickness="0,1,0,0"><DockPanel><Border DockPanel.Dock="Top" Background="#202E39" Padding="10,7"><DockPanel><TextBlock Text="运行监控" Foreground="#E0E8EC" FontWeight="SemiBold"/><TextBlock Text="{Binding LogText}" Foreground="#82939D" FontSize="10" DockPanel.Dock="Right" VerticalAlignment="Center"/></DockPanel></Border><TabControl><TabItem Header="运行结果"><DataGrid ItemsSource="{Binding ExecutionResults}" AutoGenerateColumns="False" IsReadOnly="True" Background="#1B2731" Foreground="#CED9DE" RowBackground="#1B2731" AlternatingRowBackground="#202E39" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#34434E" BorderThickness="0" HeadersVisibility="Column"><DataGrid.Columns><DataGridTextColumn Header="节点" Binding="{Binding NodeName}" Width="*"/><DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="85"/><DataGridTextColumn Header="耗时 (ms)" Binding="{Binding ElapsedMilliseconds, StringFormat=F2}" Width="95"/><DataGridTextColumn Header="错误" Binding="{Binding Error}" Width="1.2*"/></DataGrid.Columns></DataGrid></TabItem><TabItem Header="运行日志"><ListBox ItemsSource="{Binding Logs}" FontFamily="Consolas" FontSize="11"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="#B8C6CC" TextWrapping="Wrap" Margin="2"/></DataTemplate></ListBox.ItemTemplate></ListBox></TabItem><TabItem Header="性能信息"><StackPanel Margin="14"><TextBlock Text="流程级顺序调度" Foreground="#D5E0E5"/><TextBlock Text="并行执行和生产监控将在后续阶段接入。" Foreground="#82939D" Margin="0,6"/></StackPanel></TabItem></TabControl></DockPanel></Border>
   </Grid>
  </Grid>
  <Border Grid.Row="3" Background="#141D25" BorderBrush="#34434E" BorderThickness="0,1,0,0" Padding="8,2"><DockPanel><TextBlock Text="{Binding RunStateText, StringFormat=状态：{0}}" Foreground="#58B7B2" VerticalAlignment="Center"/><TextBlock x:Name="EnvironmentText" Text="HALCON 环境检查中…" Foreground="#AAB8BE" VerticalAlignment="Center" Margin="18,0"/><TextBlock Text="{Binding ProjectName}" Foreground="#AAB8BE" VerticalAlignment="Center" Margin="8,0"/><TextBlock Text="{Binding SelectedFlow.Name, StringFormat=流程：{0}}" Foreground="#AAB8BE" VerticalAlignment="Center" Margin="8,0"/><TextBlock Text="{Binding RunElapsedText, StringFormat=耗时：{0}}" Foreground="#AAB8BE" VerticalAlignment="Center" Margin="8,0"/><TextBlock Text="{Binding SelectedFlow.Zoom, StringFormat=缩放：{0:P0}}" Foreground="#AAB8BE" VerticalAlignment="Center" Margin="8,0"/><TextBlock Text="{Binding ProjectStatus}" Foreground="#8798A1" VerticalAlignment="Center" DockPanel.Dock="Right"/></DockPanel></Border>
 </Grid>
</Window>
