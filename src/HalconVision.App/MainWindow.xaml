   <Ellipse Width="12" Height="12" Fill="#42B7E9" Stroke="#DDF6FF" StrokeThickness="1.5" VerticalAlignment="Center"/>
  </Button></DataTemplate>
  <DataTemplate x:Key="NodeTemplate"><Border Width="164" Focusable="True" Background="#202D37" CornerRadius="5" Padding="0" MouseLeftButtonDown="Node_MouseDown" MouseMove="Node_MouseMove" MouseLeftButtonUp="Node_MouseUp">
