    <Border x:Name="RuntimeResultsPanel" Grid.Row="1" Grid.Column="2" Background="#1B2731" BorderBrush="#34434E" BorderThickness="0,1,0,0"><DockPanel><Border DockPanel.Dock="Top" Background="#202E39" Padding="10,7"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="运行监控" Foreground="#E0E8EC" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding LogText}" ToolTip="{Binding LogText}" TextTrimming="CharacterEllipsis" Margin="8,0,0,0" Foreground="#82939D" FontSize="10" VerticalAlignment="Center"/></Grid></Border><TabControl x:Name="RuntimeTabs"><TabItem Header="运行结果"><DataGrid ItemsSource="{Binding ExecutionResults}" AutoGenerateColumns="False" IsReadOnly="True" Background="#1B2731" Foreground="#CED9DE" RowBackground="#1B2731" AlternatingRowBackground="#202E39" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#34434E" BorderThickness="0" HeadersVisibility="Column"><DataGrid.Columns><DataGridTextColumn ElementStyle="{StaticResource WorkbenchCellText}" Header="节点" Binding="{Binding NodeName}" Width="*"/><DataGridTextColumn ElementStyle="{StaticResource WorkbenchCellText}" Header="检测结论" Binding="{Binding Converter={StaticResource NodeResultSummary}}" Width="2*"/><DataGridTextColumn ElementStyle="{StaticResource WorkbenchCellText}" Header="耗时 (ms)" Binding="{Binding ElapsedMilliseconds, StringFormat=F2}" Width="95"/><DataGridTextColumn ElementStyle="{StaticResource WorkbenchCellText}" Header="错误" Binding="{Binding Error}" Width="1.2*"/></DataGrid.Columns></DataGrid></TabItem><TabItem x:Name="NodeOutputsTab" Header="节点输出"><Grid><Grid.RowDefinitions><RowDefinition Height="2*"/><RowDefinition Height="*"/></Grid.RowDefinitions><DataGrid x:Name="NodeOutputsGrid" AutoGenerateColumns="False" IsReadOnly="True" Background="#1B2731" Foreground="#CED9DE" RowBackground="#1B2731" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#34434E"><DataGrid.Columns><DataGridTextColumn ElementStyle="{StaticResource WorkbenchCellText}" Header="输出字段" Binding="{Binding Name}" Width="*" MinWidth="95"/><DataGridTextColumn ElementStyle="{StaticResource WorkbenchCellText}" Header="类型" Binding="{Binding DataType}" Width="95"/><DataGridTextColumn ElementStyle="{StaticResource WorkbenchCellText}" Header="当前值" Binding="{Binding Value}" Width="2*" MinWidth="160"/></DataGrid.Columns></DataGrid><TextBox Grid.Row="1" Text="{Binding SelectedItem.FullValue, ElementName=NodeOutputsGrid, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" ToolTip="选中输出字段查看完整数据，可 Ctrl+C 复制"/></Grid></TabItem><TabItem Header="运行日志"><ListBox ItemsSource="{Binding Logs}" FontFamily="Consolas" FontSize="11"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="#B8C6CC" TextWrapping="Wrap" Margin="2"/></DataTemplate></ListBox.ItemTemplate></ListBox></TabItem><TabItem Header="性能信息"><StackPanel Margin="14"><TextBlock Text="流程级顺序调度" Foreground="#D5E0E5"/><TextBlock Text="并行执行和生产监控将在后续阶段接入。" Foreground="#82939D" Margin="0,6"/></StackPanel></TabItem></TabControl></DockPanel></Border>
