  </DrawingBrush>
  <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}"><Setter Property="FocusVisualStyle" Value="{StaticResource WorkbenchFocusVisual}"/><Setter Property="Foreground" Value="#D5E0E5"/><Setter Property="Background" Value="#26343F"/><Setter Property="BorderBrush" Value="#3B4A55"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="9,5"/><Setter Property="Margin" Value="2"/><Setter Property="FontSize" Value="12"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#334650"/><Setter TargetName="Bd" Property="BorderBrush" Value="#4A747A"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Background" Value="#087E83"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TextBox" BasedOn="{StaticResource WorkbenchTextBoxStyle}"/>
  <Style TargetType="TabControl"><Setter Property="Background" Value="#1B2731"/><Setter Property="BorderBrush" Value="#34434E"/></Style>
  <Style TargetType="TabItem" BasedOn="{StaticResource IconTabItemStyle}"><Setter Property="Foreground" Value="#B8C5CB"/><Setter Property="Background" Value="#202D37"/><Setter Property="Padding" Value="12,6"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="TabBorder" Background="{TemplateBinding Background}" BorderBrush="#34434E" BorderThickness="0,0,0,1" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="#17232C"/><Setter TargetName="TabBorder" Property="BorderBrush" Value="#20A6A2"/><Setter TargetName="TabBorder" Property="BorderThickness" Value="0,0,0,2"/><Setter Property="Foreground" Value="White"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TreeView"><Setter Property="Background" Value="#1B2731"/><Setter Property="Foreground" Value="#CCD7DC"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="4"/></Style>
  <Style TargetType="ListBox"><Setter Property="Background" Value="#1B2731"/><Setter Property="Foreground" Value="#CCD7DC"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="2"/></Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#26343F"/><Setter Property="Foreground" Value="#C9D5DA"/><Setter Property="BorderBrush" Value="#34434E"/><Setter Property="BorderThickness" Value="0,0,1,1"/><Setter Property="Padding" Value="8,6"/></Style>
  <Style TargetType="DataGridCell"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#CED9DE"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="7,4"/></Style>
  <Style TargetType="MenuItem" BasedOn="{StaticResource IconMenuItemStyle}"><Setter Property="Foreground" Value="#D3DEE3"/><Setter Property="Background" Value="#17212A"/><Setter Property="Padding" Value="9,2"/></Style>
