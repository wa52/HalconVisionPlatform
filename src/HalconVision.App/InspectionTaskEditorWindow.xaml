<Window x:Class="HalconVision.App.InspectionTaskEditorWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:HalconVision.App"
 Title="检测任务" Width="1100" Height="760" MinWidth="920" MinHeight="640"
 WindowStartupLocation="CenterOwner" Background="#17212A" Foreground="#DCE5E9">
 <Window.Resources>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#DCE5E9"/></Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#DCE5E9"/><Setter Property="Background" Value="#17212A"/><Setter Property="Padding" Value="8,6"/><Style.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="#31565E"/></Trigger></Style.Triggers></Style>
  <Style TargetType="ComboBox"><Setter Property="Foreground" Value="#DCE5E9"/><Setter Property="Background" Value="#121B22"/><Setter Property="BorderBrush" Value="#3B4A55"/><Setter Property="MinHeight" Value="30"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="3"><DockPanel Margin="8,4"><TextBlock DockPanel.Dock="Right" Text="▾" Margin="8,0,0,0" VerticalAlignment="Center"/><TextBlock Text="{Binding SelectedItem.Name,RelativeSource={RelativeSource TemplatedParent}}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/></DockPanel></Border>
    <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"/></ControlTemplate></ToggleButton.Template></ToggleButton>
    <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False" IsOpen="{TemplateBinding IsDropDownOpen}"><Border Background="#17212A" BorderBrush="#4A747A" BorderThickness="1" MinWidth="{Binding ActualWidth,RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="260"><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border></Popup>
   </Grid></ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="检测任务" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="区域定义位置，任务关联算法分支与判定规则。每个算法节点只属于一个任务。" Foreground="#9AADB6" TextWrapping="Wrap" Margin="0,6,12,0"/></StackPanel>
   <Button Grid.Column="1" Content="应用任务配置" Background="#087E83" Click="Apply_Click" VerticalAlignment="Top"/>
  </Grid>
  <TabControl Grid.Row="1">
   <TabItem Header="检测区域" local:IconUi.KeepText="True"><Grid Margin="10" local:IconUi.KeepText="False"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <DockPanel Margin="0,0,16,0"><WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8"><Button Content="添加检测区域" Click="AddRegion_Click"/><Button Content="移除检测区域" Click="RemoveRegion_Click"/></WrapPanel><ListBox x:Name="RegionList" ItemsSource="{Binding Regions}" DisplayMemberPath="Name"/></DockPanel>
    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"><StackPanel DataContext="{Binding SelectedItem,ElementName=RegionList}">
     <TextBlock Text="区域名称"/><TextBox AutomationProperties.Name="区域名称" Text="{Binding Name,UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,16"/>
     <TextBlock Text="图像与坐标来源"/><ComboBox AutomationProperties.Name="区域图像来源" ItemsSource="{Binding Sources,RelativeSource={RelativeSource AncestorType=Window}}" SelectedValue="{Binding SourceKey}" SelectedValuePath="Key" DisplayMemberPath="Name" Margin="0,5,0,16"/>
     <TextBlock Text="矩形坐标（行、列；保留图像原尺寸，不缩放 ROI）" Foreground="#9AADB6" TextWrapping="Wrap"/>
     <UniformGrid Columns="2" Margin="0,8,0,14"><StackPanel Margin="0,0,8,8"><TextBlock Text="起始行"/><TextBox Text="{Binding RowBegin}"/></StackPanel><StackPanel Margin="0,0,0,8"><TextBlock Text="起始列"/><TextBox Text="{Binding ColumnBegin}"/></StackPanel><StackPanel Margin="0,0,8,0"><TextBlock Text="结束行"/><TextBox Text="{Binding RowEnd}"/></StackPanel><StackPanel><TextBlock Text="结束列"/><TextBox Text="{Binding ColumnEnd}"/></StackPanel></UniformGrid>
     <Button Content="绘制任务区域" Click="DrawRegion_Click" HorizontalAlignment="Left"/>
     <TextBlock Text="绘制会把当前草稿应用到工作区并返回图像窗口；无有效当前帧时先执行图像来源。区域变化从下一轮检测生效。" Foreground="#9AADB6" TextWrapping="Wrap" Margin="0,12,0,0"/>
    </StackPanel></ScrollViewer>
   </Grid></TabItem>
   <TabItem Header="任务与规则" local:IconUi.KeepText="True"><Grid Margin="10" local:IconUi.KeepText="False"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <DockPanel Margin="0,0,16,0"><WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8"><Button Content="添加检测任务" Click="AddTask_Click"/><Button Content="移除检测任务" Click="RemoveTask_Click"/></WrapPanel><ListBox x:Name="TaskList" ItemsSource="{Binding Tasks}" DisplayMemberPath="Name" SelectionChanged="Task_SelectionChanged"/></DockPanel>
    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel DataContext="{Binding SelectedItem,ElementName=TaskList}">
     <TextBlock Text="任务名称"/><TextBox Text="{Binding Name,UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10"/>
     <WrapPanel Margin="0,0,0,12"><CheckBox Content="必检任务" IsChecked="{Binding Required}" Margin="0,0,24,0"/><CheckBox Content="启用任务" IsChecked="{Binding Enabled}"/></WrapPanel>
     <TextBlock Text="绑定区域"/><ComboBox ItemsSource="{Binding Regions,RelativeSource={RelativeSource AncestorType=Window}}" SelectedValue="{Binding RegionId}" SelectedValuePath="Id" DisplayMemberPath="Name" Margin="0,4,0,12"/>
     <TextBlock Text="算法分支（画布中先连接好；可在同一 ROI 建立多个任务）" TextWrapping="Wrap"/>
     <ListBox x:Name="MemberList" Height="125" Margin="0,5,0,12" SelectionMode="Multiple" DisplayMemberPath="Name"/>
     <DockPanel><TextBlock Text="判定规则 · 所有规则满足才合格" VerticalAlignment="Center"/><WrapPanel DockPanel.Dock="Right"><Button Content="添加判定规则" Click="AddRule_Click"/><Button Content="移除判定规则" Click="RemoveRule_Click"/></WrapPanel></DockPanel>
     <DataGrid x:Name="RulesGrid" ItemsSource="{Binding Rules}" Height="170" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" HorizontalScrollBarVisibility="Auto" Margin="0,5,0,10" Background="#121B22" Foreground="#DCE5E9" RowBackground="#202E39" AlternatingRowBackground="#26343F" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#34434E" HeadersVisibility="Column" BorderBrush="#3B4A55"/>
     <TextBlock Text="数值范围使用闭区间；字段填写 JSON Pointer（如 /Code），整个数值端口留空。检测判定仅接受已知状态；缺字段、空值及异常均为 ERROR。任务区域在执行时覆盖成员节点自身的 ROI 参数，原参数不被改写。" TextWrapping="Wrap" Foreground="#9AADB6"/>
    </StackPanel></ScrollViewer>
   </Grid></TabItem>
   <TabItem Header="本轮任务结果" local:IconUi.KeepText="True"><ScrollViewer VerticalScrollBarVisibility="Auto"><TextBlock x:Name="ResultText" Margin="14" TextWrapping="Wrap"/></ScrollViewer></TabItem>
  </TabControl>
  <Border Grid.Row="2" Background="#202E39" Padding="10" Margin="0,12,0,0"><ScrollViewer MaxHeight="84" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="Feedback" Text="配置应用到工作区后，使用项目保存写入 .hvproj。必检任务禁用、结果缺失或执行失败均不能判为 OK。" Foreground="#A7BCC5" TextWrapping="Wrap"/></ScrollViewer></Border>
 </Grid>
</Window>
